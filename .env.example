# Instagram Bot - @Sety_bozorg
# Copy this to .env and fill your credentials

# Your Instagram account (the bot account)
IG_USERNAME=your_bot_account_username
IG_PASSWORD=your_password

# Target account - the main account we work for
TARGET_USERNAME=Sety_bozorg

# 2FA secret if you have 2FA enabled (optional)
IG_2FA_SEED=

# Proxy (optional) - format: http://user:pass@host:port
IG_PROXY=

# Session file to avoid re-login
SESSION_FILE=sessions/session.json

# Bot behavior
LIKE_ENABLED=true
FOLLOW_ENABLED=true
COMMENT_ENABLED=false
DM_ENABLED=false
STORY_VIEW_ENABLED=true

# Limits per hour (safe values)
HOURLY_LIKE_LIMIT=30
HOURLY_FOLLOW_LIMIT=15
HOURLY_COMMENT_LIMIT=10
HOURLY_DM_LIMIT=10

# Dashboard
DASHBOARD_PORT=8000
DASHBOARD_PASSWORD=admin123
